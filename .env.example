# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-root

# LedgerGuard database
LG_DB_USER=ledgerguard
LG_DB_PASSWORD=change-me-lg

# Relay database
RELAY_DB_USER=relay
RELAY_DB_PASSWORD=change-me-relay

# DocuMind database
DOCUMIND_DB_USER=documind
DOCUMIND_DB_PASSWORD=change-me-documind

# AeroPulse database
AERO_DB_USER=aeropulse
AERO_DB_PASSWORD=change-me-aero

# Redis
REDIS_PASSWORD=change-me-redis

# JWT
JWT_SECRET=change-me-jwt-secret-at-least-32-chars

# Second factor for LedgerGuard's destructive /api/dev endpoints (seed and reset),
# required in addition to the ADMIN role and sent as an X-Dev-Token request header.
# Generate a long random value — `openssl rand -hex 32` — and treat it like a password.
# Leave it empty to disable those endpoints entirely; they then answer 404.
DEV_API_TOKEN=

# Grafana admin password, read by the grafana service as GF_SECURITY_ADMIN_PASSWORD.
# Grafana only reads it while initialising its database on first start — after that the
# password lives in the grafana_data volume, so editing this value later has no effect
# and the rotation has to happen in the UI (or by removing the volume, which also
# discards anything saved there).
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# Domain
DOMAIN=duvalkwali.tech
