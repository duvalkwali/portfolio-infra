# The dashboard SPA and the API it calls share this origin, so the browser issues
# same-origin requests and CORS never enters the picture in production. `handle` blocks
# are mutually exclusive and matched in the order written: anything that is not a
# backend path falls through to the static bundle.
ledgerguard.duvalkwali.tech {
	encode gzip

	handle /api/* {
		reverse_proxy ledgerguard:8080
	}
	# Listed before the general /actuator/* block below, and a longer path besides, so it
	# wins however Caddy orders the two.
	#
	# Spring Security has to leave this endpoint open: Prometheus scrapes it over the
	# compose network as ledgerguard:8080 and presents no credentials. That makes Caddy
	# the only place the public route can be closed, and it should be — the scrape
	# publishes every URI the app serves, its connection-pool state and its GC behaviour,
	# which is a free reconnaissance feed for anyone who asks. Prometheus reaches the
	# container directly and never comes through here, so this costs nothing.
	handle /actuator/prometheus {
		respond "Not Found" 404
	}
	handle /actuator/* {
		reverse_proxy ledgerguard:8080
	}
	handle /swagger-ui/* {
		reverse_proxy ledgerguard:8080
	}
	# springdoc serves the UI entry point at this exact path and redirects from it to
	# /swagger-ui/index.html. Without its own block it would fall through to the SPA.
	handle /swagger-ui.html {
		reverse_proxy ledgerguard:8080
	}
	# No trailing slash in the matcher: the spec itself is /v3/api-docs exactly, with
	# /v3/api-docs/swagger-config beside it. A /v3/api-docs/* matcher would miss the
	# former and Swagger UI would load with nothing in it.
	handle /v3/api-docs* {
		reverse_proxy ledgerguard:8080
	}

	handle {
		root * /srv/ledgerguard
		# Client-side routing: /alerts and /rules are React Router paths with no file
		# behind them, so an unmatched request serves the shell and lets the router decide.
		try_files {path} /index.html
		file_server
	}
}

relay.duvalkwali.tech {
	reverse_proxy relay:3000
	encode gzip
}

documind.duvalkwali.tech {
	reverse_proxy documind:8000
	encode gzip
}

aeropulse.duvalkwali.tech {
	reverse_proxy aeropulse:8080
	encode gzip
}

# Matches the grafana service in docker-compose.yml, which listens on 3000 and publishes
# no host port — this block is the only route to it. GF_SERVER_ROOT_URL is set to this
# hostname so Grafana's own redirects and share links agree with what is in front of it.
grafana.duvalkwali.tech {
	reverse_proxy grafana:3000
	encode gzip
}

# The portfolio landing page, built from ./landing and placed in ./www/portfolio, which
# the ./www:/srv:ro mount exposes here as /srv/portfolio.
#
# No try_files: this is a static page, not a client-side-routed app. file_server already
# serves index.html for /, and adding `try_files {path} /index.html` would make every
# unknown path answer 200 with the landing page instead of 404 — which is what an SPA
# needs and what a two-file static site should not do.
duvalkwali.tech, www.duvalkwali.tech {
	root * /srv/portfolio
	file_server
	encode gzip
}
